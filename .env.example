# Copy to .env and fill in. .env is gitignored -- never commit it.
#
# These are AMO API credentials, NOT your Mozilla account login. Generate them
# at: https://addons.mozilla.org/developers/addon/api/key/
# (Developer Hub -> Tools -> Manage API Keys). The secret is shown once.
#
# web-ext reads both of these from the environment automatically.
WEB_EXT_API_KEY=user:12345678:123
WEB_EXT_API_SECRET=

# The extension's permanent identity on AMO. Once you sign under an ID it
# cannot be changed, so decide before the first signing run.
EXT_ID=quick-look@alanmun

# --- Chrome Web Store ------------------------------------------------------
#
# Used by `npm run release:chrome` (tools/release-chrome.mjs), which posts to
# the Chrome Web Store API v2. One-time setup:
#
#   1. Google Cloud Console -> enable the "Chrome Web Store API".
#   2. Create an OAuth 2.0 Client ID of type "Web application", and add
#      https://developers.google.com/oauthplayground as a redirect URI.
#   3. PUBLISH the OAuth consent screen. Left in "Testing" it expires the
#      refresh token every 7 days, which is the usual reason this breaks.
#   4. At https://developers.google.com/oauthplayground, click the gear, tick
#      "Use your own OAuth credentials", paste the ID and secret, authorise the
#      scope https://www.googleapis.com/auth/chromewebstore, then exchange the
#      code for a refresh token.
#
# Your Google account must have 2-step verification enabled, and the item's
# Store listing and Privacy tabs must already be filled in, or publish fails.
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=

# Dashboard -> Publisher -> Settings. Not the same as the extension ID.
CWS_PUBLISHER_ID=

# From the public store URL. Defaults to the Look Up listing if unset.
CWS_EXTENSION_ID=gcmdigajlkgaldbhjikdkkdeockabepl
