{
  "name": "look-up",
  "version": "0.1.6",
  "private": true,
  "description": "Double-click any word to see what it means, without leaving the page.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node tools/render.mjs && node tools/probe.mjs && node build.mjs && node tools/smoke.mjs",
    "test:ranking": "node tools/probe.mjs",
    "test:integration": "node build.mjs && node tools/smoke.mjs",
    "senses": "node tools/senses.mjs",
    "test:render": "node tools/render.mjs",
    "lint": "node build.mjs firefox && web-ext lint --source-dir=dist/firefox --no-config-discovery",
    "package:firefox": "node build.mjs firefox && node tools/package.mjs firefox",
    "package:chrome": "node build.mjs chrome && node tools/package.mjs chrome",
    "package:source": "node tools/package.mjs source",
    "sign": "node --env-file-if-exists=.env tools/release.mjs",
    "release": "node --env-file-if-exists=.env tools/release.mjs",
    "release:dry": "node --env-file-if-exists=.env tools/release.mjs --dry-run",
    "release:chrome": "node --env-file-if-exists=.env tools/release-chrome.mjs",
    "release:chrome:dry": "node --env-file-if-exists=.env tools/release-chrome.mjs --dry-run"
  },
  "license": "MPL-2.0"
}
